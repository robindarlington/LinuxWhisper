post_install() {
    echo ""
    echo "============================================================"
    echo "  LinuxWhisper — Post-Install Setup"
    echo "============================================================"
    echo ""
    echo "  1. Add your user to the input group:"
    echo ""
    echo "     sudo usermod -aG input \$USER"
    echo ""
    echo "  2. Load the uinput kernel module (persists on next boot):"
    echo ""
    echo "     sudo modprobe uinput"
    echo ""
    echo "  3. Enable ydotool for Wayland text injection:"
    echo ""
    echo "     systemctl --user enable --now ydotool"
    echo ""
    echo "     Note: the service name is 'ydotool', NOT 'ydotoold'."
    echo ""
    echo "  4. Log out and back in for group changes to take effect."
    echo ""
    echo "  5. Start LinuxWhisper:"
    echo ""
    echo "     # One-time start:"
    echo "     linuxwhisper start"
    echo ""
    echo "     # Or enable as a systemd service (auto-start on login):"
    echo "     systemctl --user enable --now linuxwhisper"
    echo ""
    echo "  Troubleshooting:"
    echo ""
    echo "     journalctl --user -u linuxwhisper -f"
    echo ""
    echo "============================================================"
    echo ""
}

post_upgrade() {
    post_install
}
